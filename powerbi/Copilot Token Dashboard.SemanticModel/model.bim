            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Periods",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "ReadTable(\"Periods.csv\",\"TGFiZWwsTW9kZSxEYXlzLFNvcnRPcmRlcg0KTGFzdCA3IGRheXMsUm9sbGluZyw3LDENCkxhc3QgMjggZGF5cyxSb2xsaW5nLDI4LDINCkxhc3QgOTAgZGF5cyxSb2xsaW5nLDkwLDMNCk1vbnRoIHRvIGRhdGUsTVRELDAsNA0KWWVhciB0byBkYXRlLFlURCwwLDUNCg==\",{{\"Label\",type text},{\"Mode\",type text},{\"Days\",Int64.Type},{\"SortOrder\",Int64.Type}})"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "isHidden": false
      },
      {
        "name": "Currencies",
        "columns": [
          {
            "name": "Code",
            "dataType": "string",
            "sourceColumn": "Code",
            "summarizeBy": "none"
          },
          {
            "name": "Multiplier",
            "dataType": "double",
            "sourceColumn": "Multiplier",
            "summarizeBy": "none",
            "formatString": "0.00"
          },
          {
            "name": "Symbol",
            "dataType": "string",
            "sourceColumn": "Symbol",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Currencies",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "ReadTable(\"Currencies.csv\",\"Q29kZSxNdWx0aXBsaWVyLFN5bWJvbA0KVVNELDEuMCxVU0QgDQo=\",{{\"Code\",type text},{\"Multiplier\",type number},{\"Symbol\",type text}})"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "isHidden": false
      },
      {
        "name": "HourlyRate",
        "columns": [
          {
            "name": "Rate",
            "dataType": "double",
            "sourceColumn": "Rate",
            "summarizeBy": "none",
            "formatString": "0.00"
          }
        ],
        "partitions": [
          {
            "name": "HourlyRate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "ReadTable(\"HourlyRate.csv\",\"\",{{\"Rate\",type number}})"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "isHidden": false
      },
      {
        "name": "Measures",
        "columns": [
          {
            "name": "Value",
            "sourceColumn": "Value",
            "dataType": "int64",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [Value=Int64.Type],{{0}})"
            }
          }
        ],
        "measures": [
          {
            "name": "Anchor Date",
            "expression": "MAX(Settings[AnchorDate])",
            "displayFolder": "Context",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Data Banner",
            "expression": "IF(SELECTEDVALUE(Settings[IsDemo],FALSE()), \"SYNTHETIC DEMO - NOT LIVE DATA\", \"CUSTOMER DATA - REVIEW COVERAGE\")",
            "displayFolder": "Context"
          },
          {
            "name": "Viewer UPN",
            "expression": "VAR u=USERPRINCIPALNAME() VAR known=COUNTROWS(FILTER(ALL(People),LOWER(People[UPN])=LOWER(u))) RETURN IF(known>0 || NOT SELECTEDVALUE(Settings[IsDemo],FALSE()),u,\"user01@example.com\")",
            "displayFolder": "Context"
          },
          {
            "name": "Viewer Greeting",
            "expression": "\"Private usage for \" & [Viewer UPN]",
            "displayFolder": "Context"
          },
          {
            "name": "Selected Period",
            "expression": "SELECTEDVALUE(Periods[Label], \"Last 28 days\")",
            "displayFolder": "Context"
          },
          {
            "name": "Selected Scope",
            "expression": "COALESCE(SELECTEDVALUE(Scopes[ScopeKey]), LOOKUPVALUE(People[ScopeKey], People[UPN], [Viewer UPN]))",
            "displayFolder": "Context"
          },
          {
            "name": "Period Start",
            "expression": "VAR a=[Anchor Date] VAR mode=SELECTEDVALUE(Periods[Mode],\"Rolling\") VAR days=SELECTEDVALUE(Periods[Days],28) RETURN SWITCH(mode,\"MTD\",DATE(YEAR(a),MONTH(a),1),\"YTD\",DATE(YEAR(a),1,1),a-days+1)",
            "displayFolder": "Context",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Privacy Minimum",
            "expression": "MAX(6,MAX(Settings[MinimumGroupSize]))",
            "displayFolder": "Context",
            "formatString": "0"
          },
          {
            "name": "Currency Multiplier",
            "expression": "SELECTEDVALUE(Currencies[Multiplier],1)",
            "displayFolder": "Context",
            "formatString": "0.0000"
          },
          {
            "name": "Currency Code",
            "expression": "SELECTEDVALUE(Currencies[Code],MAX(Settings[BaseCurrency]))",
            "displayFolder": "Context"
          },
          {
            "name": "Data Date Label",
            "expression": "\"Data through \" & FORMAT([Anchor Date],\"yyyy-MM-dd\")",
            "displayFolder": "Context"
          },
          {
            "name": "Scope Name",
            "expression": "LOOKUPVALUE(Scopes[Name],Scopes[ScopeKey],[Selected Scope])",
            "displayFolder": "Context"
          },
          {
            "name": "Personal Privacy Note",
            "expression": "\"Personal records are self-only under Viewer RLS. Workspace administrators are trusted custodians.\"",
            "displayFolder": "Guidance"
          },
          {
            "name": "Data Quality Note",
            "expression": "\"Missing metrics are not zero. Costs are reported/estimated subtotals; inspect coverage and unpriced records.\"",
            "displayFolder": "Guidance"
          },
          {
            "name": "Usage Note",
            "expression": "\"Activity and spend do not measure employee performance. Sources and measurement units differ.\"",
            "displayFolder": "Guidance"
          },
          {
            "name": "Momentum Note",
            "expression": "\"Last six completed weeks versus the preceding six. Intensity is reported requests per active user-week.\"",
            "displayFolder": "Guidance"
          },
          {
            "name": "Value Note",
            "expression": "\"Scenario estimates use owner assumptions and a blended hourly rate. They are not causal productivity evidence.\"",
            "displayFolder": "Guidance"
          },
          {
            "name": "Source Note",
            "expression": "\"Microsoft 365 period summaries are not daily request counts. GitHub cache details are not universally exposed.\"",
            "displayFolder": "Guidance"
          },
          {
            "name": "Production Note",
            "expression": "\"Set customer sources, validate data, assign Viewer RLS and credentials, then complete tenant smoke tests.\"",
            "displayFolder": "Guidance"
          },
          {
            "name": "Hourly Rate",
            "expression": "SELECTEDVALUE(HourlyRate[Rate],20)",
            "displayFolder": "Value",
            "formatString": "0.00"
          },
          {
            "name": "My Known Spend",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[Amount]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))*[Currency Multiplier]",
            "displayFolder": "Personal",
            "formatString": "#,0.00"
          },
          {
            "name": "My Input Tokens",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[InputTokens]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Cached Input Tokens",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[CachedInputTokens]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Cache Write Tokens",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[CacheWriteTokens]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Output Tokens",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[OutputTokens]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Requests",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[Requests]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Sessions",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[Sessions]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Agent Runs",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[AgentRuns]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Premium Requests",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[PremiumRequests]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0.00"
          },
          {
            "name": "My Copilot Credits",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[CopilotCredits]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0.00"
          },
          {
            "name": "My GitHub AI Credits",
            "expression": "VAR u=[Viewer UPN] VAR start=[Period Start] VAR finish=[Anchor Date] RETURN CALCULATE(SUM(UsageDaily[GitHubAiCredits]),KEEPFILTERS(People[UPN]=u),KEEPFILTERS(DATESBETWEEN(Calendar[Date],start,finish)))",
            "displayFolder": "Personal",
            "formatString": "#,0.00"
          },
          {
            "name": "My Spend 7 Days",
            "expression": "VAR u=[Viewer UPN] RETURN CALCULATE(SUM(UsageDaily[Amount]),KEEPFILTERS(People[UPN]=u),DATESBETWEEN(Calendar[Date],[Anchor Date]-6,[Anchor Date]))*[Currency Multiplier]",
            "displayFolder": "Personal",
            "formatString": "#,0.00"
          },
          {
            "name": "My Spend 28 Days",
            "expression": "VAR u=[Viewer UPN] RETURN CALCULATE(SUM(UsageDaily[Amount]),KEEPFILTERS(People[UPN]=u),DATESBETWEEN(Calendar[Date],[Anchor Date]-27,[Anchor Date]))*[Currency Multiplier]",
            "displayFolder": "Personal",
            "formatString": "#,0.00"
          },
          {
            "name": "My Spend MTD",
            "expression": "VAR u=[Viewer UPN] RETURN CALCULATE(SUM(UsageDaily[Amount]),KEEPFILTERS(People[UPN]=u),DATESBETWEEN(Calendar[Date],DATE(YEAR([Anchor Date]),MONTH([Anchor Date]),1),[Anchor Date]))*[Currency Multiplier]",
            "displayFolder": "Personal",
            "formatString": "#,0.00"
          },
          {
            "name": "My Reported Tokens",
            "expression": "[My Input Tokens]+[My Output Tokens]",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Active Days",
            "expression": "VAR u=[Viewer UPN] RETURN CALCULATE(DISTINCTCOUNT(UsageDaily[Date]),KEEPFILTERS(People[UPN]=u),UsageDaily[ActivityObserved]=TRUE(),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Cache Coverage Gaps",
            "expression": "VAR u=[Viewer UPN] RETURN CALCULATE(COUNTROWS(UsageDaily),KEEPFILTERS(People[UPN]=u),NOT ISBLANK(UsageDaily[InputTokens]),ISBLANK(UsageDaily[CachedInputTokens]),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Cache Write Coverage Gaps",
            "expression": "VAR u=[Viewer UPN] RETURN CALCULATE(COUNTROWS(UsageDaily),KEEPFILTERS(People[UPN]=u),NOT ISBLANK(UsageDaily[InputTokens]),ISBLANK(UsageDaily[CacheWriteTokens]),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Cache Hit Ratio",
            "expression": "IF([My Cache Coverage Gaps]=0,DIVIDE([My Cached Input Tokens],[My Input Tokens]))",
            "displayFolder": "Personal",
            "formatString": "0.0%"
          },
          {
            "name": "My Uncached Input Tokens",
            "expression": "IF([My Cache Coverage Gaps]=0 && [My Cache Write Coverage Gaps]=0,[My Input Tokens]-[My Cached Input Tokens]-[My Cache Write Tokens])",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Token Requests",
            "expression": "VAR u=[Viewer UPN] RETURN CALCULATE(SUM(UsageDaily[Requests]),KEEPFILTERS(People[UPN]=u),NOT ISBLANK(UsageDaily[InputTokens]),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Tokens per Request",
            "expression": "DIVIDE([My Reported Tokens],[My Token Requests])",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Unpriced Records",
            "expression": "VAR u=[Viewer UPN] RETURN CALCULATE(COUNTROWS(UsageDaily),KEEPFILTERS(People[UPN]=u),NOT ISBLANK(UsageDaily[InputTokens]),ISBLANK(UsageDaily[Amount]),UsageDaily[CostBasis]<>\"billed separately\",DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))",
            "displayFolder": "Personal",
            "formatString": "#,0"
          },
          {
            "name": "My Cost Label",
            "expression": "IF(SELECTEDVALUE(UsageDaily[BillingKind])=\"licence-included\",\"Not usage billed\",IF(ISBLANK([My Known Spend]),\"Not reported\",FORMAT([My Known Spend],\"0.00\")))",
            "displayFolder": "Personal"
          },
          {
            "name": "My Model Reconciliation",
            "expression": "[My Known Spend]-SUMX(VALUES(Models[ModelKey]),[My Known Spend])",
            "displayFolder": "Quality",
            "formatString": "0.0000"
          },
          {
            "name": "Scope Known Spend",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[Amount]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())*[Currency Multiplier]",
            "displayFolder": "Organization",
            "formatString": "#,0.00"
          },
          {
            "name": "Scope Input Tokens",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[InputTokens]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Cached Input Tokens",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[CachedInputTokens]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Output Tokens",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[OutputTokens]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Requests",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[Requests]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Agent Runs",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[AgentRuns]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Active Users",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[ActiveUsers]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope User Days",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[UserDays]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Member Count",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[MemberCount]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Unpriced Records",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(ScopePeriod[UnpricedRows]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(ScopePeriod[PeriodLabel]=period),ScopePeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Reported Tokens",
            "expression": "[Scope Input Tokens]+[Scope Output Tokens]",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Adoption",
            "expression": "DIVIDE([Scope Active Users],[Scope Member Count])",
            "displayFolder": "Organization",
            "formatString": "0.0%"
          },
          {
            "name": "Scope MTD Spend",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopePeriod[Amount]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopePeriod[PeriodLabel]=\"Month to date\",ScopePeriod[PrivacySuppressed]=FALSE())*[Currency Multiplier]",
            "displayFolder": "Organization",
            "formatString": "#,0.00"
          },
          {
            "name": "Scope Breakdown Spend",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeDaily[Amount]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeDaily[PrivacySuppressed]=FALSE(),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))*[Currency Multiplier]",
            "displayFolder": "Organization",
            "formatString": "#,0.00"
          },
          {
            "name": "Scope Breakdown Tokens",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeDaily[InputTokens])+SUM(ScopeDaily[OutputTokens]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeDaily[PrivacySuppressed]=FALSE(),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Scope Weekly Spend",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeWeekly[Amount]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeWeekly[SurfaceKey]=\"all\",ScopeWeekly[PrivacySuppressed]=FALSE())*[Currency Multiplier]",
            "displayFolder": "Organization",
            "formatString": "#,0.00"
          },
          {
            "name": "Scope Weekly Active Users",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeWeekly[ActiveUsers]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeWeekly[SurfaceKey]=\"all\",ScopeWeekly[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Hidden Breakdown Difference",
            "expression": "[Scope Known Spend]-[Scope Breakdown Spend]",
            "displayFolder": "Quality",
            "formatString": "#,0.00"
          },
          {
            "name": "Weekly High",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeWeekly[High]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeWeekly[SurfaceKey]=\"all\",ScopeWeekly[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Weekly Moderate",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeWeekly[Moderate]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeWeekly[SurfaceKey]=\"all\",ScopeWeekly[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Weekly Low",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeWeekly[Low]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeWeekly[SurfaceKey]=\"all\",ScopeWeekly[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Weekly None",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeWeekly[None]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeWeekly[SurfaceKey]=\"all\",ScopeWeekly[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Weekly NoRecorded",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(SUM(ScopeWeekly[NoRecorded]),KEEPFILTERS(Scopes[ScopeKey]=scope),ScopeWeekly[SurfaceKey]=\"all\",ScopeWeekly[PrivacySuppressed]=FALSE())",
            "displayFolder": "Organization",
            "formatString": "#,0"
          },
          {
            "name": "Agent Spend",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(AgentPeriod[Amount]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(AgentPeriod[PeriodLabel]=period),AgentPeriod[PrivacySuppressed]=FALSE())*[Currency Multiplier]",
            "displayFolder": "Agents",
            "formatString": "#,0.00"
          },
          {
            "name": "Agent Runs",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(AgentPeriod[AgentRuns]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(AgentPeriod[PeriodLabel]=period),AgentPeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Agents",
            "formatString": "#,0"
          },
          {
            "name": "Agent Users",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(AgentPeriod[ActiveUsers]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(AgentPeriod[PeriodLabel]=period),AgentPeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Agents",
            "formatString": "#,0"
          },
          {
            "name": "Agent Input Tokens",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(AgentPeriod[InputTokens]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(AgentPeriod[PeriodLabel]=period),AgentPeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Agents",
            "formatString": "#,0"
          },
          {
            "name": "Agent Output Tokens",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(AgentPeriod[OutputTokens]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(AgentPeriod[PeriodLabel]=period),AgentPeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Agents",
            "formatString": "#,0"
          },
          {
            "name": "Agent Cached Input",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SUM(AgentPeriod[CachedInputTokens]),KEEPFILTERS(Scopes[ScopeKey]=scope),KEEPFILTERS(AgentPeriod[PeriodLabel]=period),AgentPeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Agents",
            "formatString": "#,0"
          },
          {
            "name": "Active Agents",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(DISTINCTCOUNT(AgentPeriod[AgentKey]),KEEPFILTERS(Scopes[ScopeKey]=scope),AgentPeriod[PeriodLabel]=period,AgentPeriod[AgentRuns]>0,AgentPeriod[PrivacySuppressed]=FALSE())",
            "displayFolder": "Agents",
            "formatString": "#,0"
          },
          {
            "name": "Agent Cost per Run",
            "expression": "DIVIDE([Agent Spend],[Agent Runs])",
            "displayFolder": "Agents",
            "formatString": "#,0.00"
          },
          {
            "name": "Agent Tokens per Run",
            "expression": "DIVIDE([Agent Input Tokens]+[Agent Output Tokens],[Agent Runs])",
            "displayFolder": "Agents",
            "formatString": "#,0"
          },
          {
            "name": "Agent Cache Ratio",
            "expression": "DIVIDE([Agent Cached Input],[Agent Input Tokens])",
            "displayFolder": "Agents",
            "formatString": "0.0%"
          },
          {
            "name": "Agent Name",
            "expression": "SELECTEDVALUE(Agents[Name],\"Select one agent on this page\")",
            "displayFolder": "Agents"
          },
          {
            "name": "Agent User Growth",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(AVERAGE(AgentPeriod[UserGrowth]),KEEPFILTERS(Scopes[ScopeKey]=scope),AgentPeriod[PeriodLabel]=period)",
            "displayFolder": "Agents",
            "formatString": "0.0%"
          },
          {
            "name": "Agent Intensity Growth",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(AVERAGE(AgentPeriod[IntensityGrowth]),KEEPFILTERS(Scopes[ScopeKey]=scope),AgentPeriod[PeriodLabel]=period)",
            "displayFolder": "Agents",
            "formatString": "0.0%"
          },
          {
            "name": "Agent Trend",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(SELECTEDVALUE(AgentPeriod[TrendClass]),KEEPFILTERS(Scopes[ScopeKey]=scope),AgentPeriod[PeriodLabel]=period)",
            "displayFolder": "Agents"
          },
          {
            "name": "Spend Spike Agents",
            "expression": "VAR scope=[Selected Scope] VAR period=[Selected Period] RETURN CALCULATE(DISTINCTCOUNT(AgentPeriod[AgentKey]),KEEPFILTERS(Scopes[ScopeKey]=scope),AgentPeriod[PeriodLabel]=period,AgentPeriod[SpikeFlag]=TRUE())",
            "displayFolder": "Agents",
            "formatString": "#,0"
          },
          {
            "name": "Resolved Work Items",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(COUNTROWS(Outcomes),KEEPFILTERS(Scopes[ScopeKey]=scope),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))",
            "displayFolder": "Outcomes",
            "formatString": "#,0"
          },
          {
            "name": "AI Involved Share",
            "expression": "VAR scope=[Selected Scope] VAR involved=CALCULATE(COUNTROWS(Outcomes),KEEPFILTERS(Scopes[ScopeKey]=scope),Outcomes[HandlingMode]<>\"Human only\",DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date])) RETURN DIVIDE(involved,[Resolved Work Items])",
            "displayFolder": "Outcomes",
            "formatString": "0.0%"
          },
          {
            "name": "Agent Resolved Share",
            "expression": "VAR scope=[Selected Scope] VAR resolved=CALCULATE(COUNTROWS(Outcomes),KEEPFILTERS(Scopes[ScopeKey]=scope),Outcomes[HandlingMode]=\"Agent-resolved\",DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date])) RETURN DIVIDE(resolved,[Resolved Work Items])",
            "displayFolder": "Outcomes",
            "formatString": "0.0%"
          },
          {
            "name": "Resolution Hours",
            "expression": "VAR scope=[Selected Scope] RETURN CALCULATE(AVERAGE(Outcomes[ResolutionHours]),KEEPFILTERS(Scopes[ScopeKey]=scope),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date]))",
            "displayFolder": "Outcomes",
            "formatString": "0.00"
          },
          {
            "name": "Human Resolution Hours",
            "expression": "CALCULATE([Resolution Hours],Outcomes[HandlingMode]=\"Human only\")",
            "displayFolder": "Outcomes",
            "formatString": "0.00"
          },
          {
            "name": "Agent Resolution Hours",
            "expression": "CALCULATE([Resolution Hours],Outcomes[HandlingMode]<>\"Human only\")",
            "displayFolder": "Outcomes",
            "formatString": "0.00"
          },
          {
            "name": "Measured Effort Saved Hours",
            "expression": "VAR scope=[Selected Scope] VAR baseline=CALCULATE(AVERAGE(Outcomes[HumanEffortMinutes]),KEEPFILTERS(Scopes[ScopeKey]=scope),Outcomes[HandlingMode]=\"Human only\",REMOVEFILTERS(Agents),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date])) RETURN IF(NOT ISBLANK(baseline),CALCULATE(SUMX(Outcomes,IF(Outcomes[HandlingMode]<>\"Human only\" && NOT ISBLANK(Outcomes[HumanEffortMinutes]),MAX(0,baseline-Outcomes[HumanEffortMinutes])/60)),KEEPFILTERS(Scopes[ScopeKey]=scope),DATESBETWEEN(Calendar[Date],[Period Start],[Anchor Date])))",
            "displayFolder": "Outcomes",
            "formatString": "0.0"
          },
          {
            "name": "Estimated Hours Saved",
            "expression": "SUMX(VALUES(Agents[AgentKey]),DIVIDE([Agent Runs]*CALCULATE(MAX(Agents[MinutesSavedPerRun])),60))",
            "displayFolder": "Value",
            "formatString": "0.0"
          },
          {
            "name": "Estimated Value",
            "expression": "[Estimated Hours Saved]*[Hourly Rate]*[Currency Multiplier]",
            "displayFolder": "Value",
            "formatString": "#,0.00"
          },
          {
            "name": "Net Scenario Value",
            "expression": "[Estimated Value]-[Agent Spend]",
            "displayFolder": "Value",
            "formatString": "#,0.00"
          },
          {
            "name": "Scenario Value Cost Ratio",
            "expression": "DIVIDE([Estimated Value],[Agent Spend])",
            "displayFolder": "Value",
            "formatString": "0.0"
          },
          {
            "name": "Month Budget",
            "expression": "VAR scope=[Selected Scope] VAR month=DATE(YEAR([Anchor Date]),MONTH([Anchor Date]),1) RETURN CALCULATE(SUM(Budgets[BudgetAmount]),KEEPFILTERS(Scopes[ScopeKey]=scope),Budgets[MonthStart]=month)*[Currency Multiplier]",
            "displayFolder": "Budget",
            "formatString": "#,0.00"
          },
          {
            "name": "Prorated Budget",
            "expression": "[Month Budget]*DIVIDE(DAY([Anchor Date]),DAY(EOMONTH([Anchor Date],0)))",
            "displayFolder": "Budget",
            "formatString": "#,0.00"
          },
          {
            "name": "Budget Used Ratio",
            "expression": "DIVIDE([Scope MTD Spend],[Prorated Budget])",
            "displayFolder": "Budget",
            "formatString": "0.0%"
          },
          {
            "name": "Budget Variance",
            "expression": "[Scope MTD Spend]-[Prorated Budget]",
            "displayFolder": "Budget",
            "formatString": "#,0.00"
          },
          {
            "name": "Coverage Fields Reported",
            "expression": "CALCULATE(COUNTROWS(Coverage),Coverage[Status]=\"Reported\")",
            "displayFolder": "Quality",
            "formatString": "#,0"
          },
          {
            "name": "Coverage Fields Missing",
            "expression": "CALCULATE(COUNTROWS(Coverage),Coverage[Status]=\"Not reported\")",
            "displayFolder": "Quality",
            "formatString": "#,0"
          },
          {
            "name": "Coverage Fields Partial",
            "expression": "CALCULATE(COUNTROWS(Coverage),Coverage[Status]=\"Partial\")",
            "displayFolder": "Quality",
            "formatString": "#,0"
          }
        ]
      }
    ],
