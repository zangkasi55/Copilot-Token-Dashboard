    "expressions": [
      {
        "name": "SourceMode",
        "kind": "m",
        "expression": "\"Demo\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true, List={\"Demo\",\"CSV\",\"SharePoint\"}]"
      },
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]"
      },
      {
        "name": "SharePointSite",
        "kind": "m",
        "expression": "\"\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]"
      },
      {
        "name": "SharePointFolder",
        "kind": "m",
        "expression": "\"\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]"
      },
      {
        "name": "ReadTable",
        "kind": "m",
        "expression": "(fileName as text, embeddedCsv as text, columnTypes as list) as table =>\nlet\n    BinarySource =\n        if SourceMode = \"Demo\" then Binary.FromText(embeddedCsv, BinaryEncoding.Base64)\n        else if SourceMode = \"CSV\" then\n            if Text.Trim(DataFolder) = \"\" then error \"DataFolder is required for CSV mode.\"\n            else File.Contents(DataFolder & \"\\\" & fileName)\n        else if SourceMode = \"SharePoint\" then\n            let\n                Checked = if Text.Trim(SharePointSite) = \"\" or Text.Trim(SharePointFolder) = \"\"\n                    then error \"SharePointSite and SharePointFolder are required.\" else SharePointSite,\n                Files = SharePoint.Files(Checked, [ApiVersion = 15]),\n                Matches = Table.SelectRows(Files, each [Name] = fileName and [Folder Path] = SharePointFolder),\n                Selected = if Table.RowCount(Matches) <> 1\n                    then error \"Expected exactly one matching SharePoint CSV file.\" else Matches{0}[Content]\n            in Selected\n        else error \"SourceMode must be Demo, CSV, or SharePoint.\",\n    Csv = Csv.Document(BinarySource, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),\n    Expected = List.Transform(columnTypes, each _{0}),\n    CheckedHeaders = if Table.ColumnNames(Headers) <> Expected\n        then error \"CSV columns do not match the published data contract.\" else Headers,\n    Nulls = Table.ReplaceValue(CheckedHeaders, \"\", null, Replacer.ReplaceValue, Expected),\n    Typed = Table.TransformColumnTypes(Nulls, columnTypes, \"en-US\")\nin\n    Typed"
      }
    ],
    "roles": [
      {
        "name": "Viewer",
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "People",
            "filterExpression": "LOWER([UPN])=LOWER(USERPRINCIPALNAME())"
          },
          {
            "name": "Accounts",
            "filterExpression": "LOWER([UPN])=LOWER(USERPRINCIPALNAME())"
          },
          {
            "name": "ScopeAccess",
            "filterExpression": "LOWER([ViewerUPN])=LOWER(USERPRINCIPALNAME())"
          },
          {
            "name": "Scopes",
            "filterExpression": "[MemberCount]>=6 && [ScopeKey] IN CALCULATETABLE(VALUES(ScopeAccess[ScopeKey]),LOWER(ScopeAccess[ViewerUPN])=LOWER(USERPRINCIPALNAME()))"
          },
          {
            "name": "ScopeDaily",
            "filterExpression": "[PrivacySuppressed]=FALSE()"
          },
          {
            "name": "ScopeWeekly",
            "filterExpression": "[PrivacySuppressed]=FALSE()"
          },
          {
            "name": "ScopePeriod",
            "filterExpression": "[PrivacySuppressed]=FALSE()"
          },
          {
            "name": "AgentPeriod",
            "filterExpression": "[PrivacySuppressed]=FALSE()"
          }
        ]
      }
    ],
